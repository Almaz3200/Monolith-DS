    .desc = { ent-BaseStructure.desc }
ent-GeneratorSterling = ZQ-340 sterling generator
    .desc = A highly inefficient and expensive yet stealthy generator developed under TSFN-SWP. Drains plasma like there's no tomorrow, but you can bet on it hiding you thermally.
    .suffix = Plasma, 40 kW
ent-GeneratorSterlingShuttle = { ent-GeneratorSterling }
    .desc = { ent-GeneratorSterling.desc }
    .suffix = Plasma, 40 kW, Ship
ent-GeneratorSterlingPDV = RD-540 sterling generator
    .desc = A highly inefficient and expensive yet stealthy generator, reverse-engineered from TSF ZQ-340s. Drains plasma like there's no tomorrow, but you can bet on it hiding you thermally.
    .suffix = { ent-GeneratorSterling.suffix }
