ent-CapsuleEconomy = капсула хранения
    .desc = Используется для хранения химикатов и других веществ, необходимых в промышленных процессах.
ent-CapsuleLargeEconomy = большая капсула хранения
    .desc = Используется для хранения химикатов и других веществ, необходимых в промышленных процессах. Значительно больше своей базовой версии.
ent-MatterBinEconomy1 = component bin
    .desc = Used for storing chemicals and other substances needed for industrial processes. Can be opened and closed. Don't use as a component while it has reagents inside!
ent-MatterBinEconomy2 = large component bin
    .desc = Used for storing chemicals and other substances needed for industrial processes. Much larger than its predecessor. Can be opened and closed. Don't use as a component while it has reagents inside!
    .suffix = { ent-BaseEconomyGoodTier2.suffix }
ent-MatterBinEconomy2Spawner = basic components
    .desc = A casing of mechanical-electrical interfacing systems, like gears, stepper motors, cabling and more.
    .suffix = { ent-BaseEconomyGoodTier2.suffix }
ent-MatterBinEconomy3 = supercomponent bin
    .desc = Used for storing chemicals and other substances needed for industrial processes. Much larger than its predecessor. Can be opened and closed. Don't use as a component while it has reagents inside!
    .suffix = { ent-BaseEconomyGoodTier3.suffix }
ent-MicroprocessorEconomy1 = microprocessor
    .desc = A fairly common field programmable microcontroller. Useful in everything that needs even a smidge of brain.
    .suffix = { ent-BaseEconomyGoodTier1.suffix }
ent-MicroprocessorEconomy2 = nanoprocessor
    .desc = A more advanced, miniaturized computation system, capable of handling a basic operating system!
    .suffix = { ent-BaseEconomyGoodTier2.suffix }
ent-MicroprocessorEconomy3 = quantum processor
    .desc = A state-of-the-art quantum computing system with in-built cooling, memory, and back-up power supply, capable of handling everything from persona level A.I to FTL piloting.
    .suffix = { ent-BaseEconomyGoodTier3.suffix }
ent-CapacitorEconomy1 = industrial basic capacitor
    .desc = A simple capacitor useful in small-scale power storage and simple circuits.
    .suffix = { ent-BaseEconomyGoodTier1.suffix }
ent-CapacitorEconomy2 = industrial advanced capacitor
    .desc = An upgraded capacitor capable of handling more voltage and storing more energy through the power of refined semiconductors.
    .suffix = { ent-BaseEconomyGoodTier2.suffix }
ent-CapacitorEconomy3 = industrial supercapacitor
    .desc = A state-of-the-art capacitor capable of storing incredible amounts of energy for its size through the use of miniaturized SMES technology.
    .suffix = { ent-BaseEconomyGoodTier3.suffix }
ent-ComponentBrickEconomy1 = basic components
    .desc = A casing of mechanical-electrical interfacing systems, like gears, stepper motors, cabling and more.
    .suffix = { ent-BaseEconomyGoodTier2.suffix }
ent-ComponentBrickEconomy1SpawnerT2 = basic components
    .desc = A casing of mechanical-electrical interfacing systems, like gears, stepper motors, cabling and more.
    .suffix = { ent-BaseEconomyGoodTier2.suffix }
ent-ComponentBrickEconomy2 = advanced components
    .desc = A casing of more advanced, precise and durable mechanical-electrical interfacing systems.
    .suffix = { ent-BaseEconomyGoodTier3.suffix }
ent-ComponentBrickEconomy3 = super components
    .desc = A casing of state-of-the-art interfacing systems and miscellaneous parts. Robust, efficient, and expensive.
    .suffix = { ent-BaseEconomyGoodTier4.suffix }
ent-ElectromagnetEconomy1 = basic electromagnet
    .desc = A circular ring composed of magnetic metal and conductive cabling. Useful for containment structures and mechanical/electrical interfacing. Add basic components to start assembling a compound electromagnet.
    .suffix = { ent-BaseEconomyGoodTier1.suffix }
ent-ElectromagnetEconomy2Start = compound electromagnet (unfinished)
    .desc = A work-in-progress compound electromagnet. Needs 10 LV cables to begin construction.
    .suffix = { ent-BaseEconomyGoodTier1.suffix }
ent-ElectromagnetEconomy2 = compound electromagnet
    .desc = A stacked electromagnet in the shape of a tube, lined with strong conductive material. Capable of powerfully interchanging electrical and kinetic energy.
    .suffix = { ent-BaseEconomyGoodTier2.suffix }
ent-ElectromagnetEconomy3Start = superconductive electromagnet (unfinished)
    .desc = A work-in-progress superconductive electromagnet. Needs further assembling in an precision assembler.
    .suffix = { ent-BaseEconomyGoodTier2.suffix }
ent-ElectromagnetEconomy3 = superconductive electromagnet
    .desc = A hefty superconducting electromagnet. Extremely useful for high-energy containment and propulsion.
    .suffix = { ent-BaseEconomyGoodTier3.suffix }
ent-RadioEconomy1 = T/R broadband radio component
    .desc = A transmitter/reciever radio component capable of tuning and transmitting to most common radio frequencies, even at a distance.
    .suffix = { ent-BaseEconomyGoodTier2.suffix }
ent-RadioEconomy2 = HF signal tranciever component
    .desc = A high-frequency signal transmitter/reciever, capable of intercepting and communicating in various frequencies. The range of detection also gives it utility in high-end sensor systems, like radar, ELINT, and thermal panels.
    .suffix = { ent-BaseEconomyGoodTier4.suffix }
ent-OpticsEconomy1 = optical sensor
    .desc = An eye-like camera capable of capturing photons. Basically a fancy eyeball, though it has other uses.
    .suffix = { ent-BaseEconomyGoodTier1.suffix }
ent-OpticsEconomy2 = precision optical sensor
    .desc = An advanced, high-resolution photon sensor capable of maintaining visual clarity of distant objects. Extremely useful for monitoring, detection and tracking equipment.
    .suffix = { ent-BaseEconomyGoodTier3.suffix }
ent-CameraEconomy1 = photonic flash camera
    .desc = An optical sensor adapted to both emit and recieve high-energy photons. Useful.
    .suffix = { ent-BaseEconomyGoodTier2.suffix }
ent-MotorEconomy1 = industrial motor
    .desc = A powerful and dedicated electromotor, useful in high-torque-requiring electric-mechanical energy conversion.
    .suffix = { ent-BaseEconomyGoodTier2.suffix }
