<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:rp="clr-namespace:Content.Client._LuaM.RpPanel"
               x:Class="Content.Client._LuaM.RpPanel.RpCustomEmoteWindow"
               HeaderClass="DS14MenuHeader"
               TitleClass="DS14MenuTitle"
               Title="{Loc rp-custom-emote-title-new}"
               Resizable="False"
               SetWidth="460">
    <PanelContainer StyleClasses="DS14MenuShell" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
            <BoxContainer Orientation="Horizontal" SeparationOverride="10">
                <PanelContainer StyleClasses="RpPanelIconFrame" SetSize="48 48" VerticalAlignment="Top">
                    <TextureRect Name="IconPreview"
                                 Stretch="KeepAspectCentered"
                                 SetSize="40 40"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                </PanelContainer>
                <GridContainer Columns="2"
                               HorizontalExpand="True"
                               HSeparationOverride="6"
                               VSeparationOverride="6">
                    <Label Text="{Loc rp-custom-emote-name}" StyleClasses="RpPanelMuted" MinWidth="90"/>
                    <LineEdit Name="NameInput" StyleClasses="DS14MenuInput" HorizontalExpand="True"/>
                    <Label Text="{Loc rp-custom-emote-body-part}" StyleClasses="RpPanelMuted"/>
                    <OptionButton Name="CategorySelector" StyleClasses="RpPanelOption" HorizontalExpand="True"/>
                    <Label Text="{Loc rp-custom-emote-kind}" StyleClasses="RpPanelMuted"/>
                    <OptionButton Name="KindSelector"
                                  StyleClasses="RpPanelOption"
                                  HorizontalExpand="True"
                                  ToolTip="{Loc rp-custom-emote-kind-tooltip}"/>
                    <Label Text="{Loc rp-custom-emote-sound}" StyleClasses="RpPanelMuted"/>
                    <rp:RpSoundOptionButton Name="SoundSelector" StyleClasses="RpPanelOption" HorizontalExpand="True"/>
                </GridContainer>
            </BoxContainer>

            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Button Name="TargetModeButton"
                        ToggleMode="True"
                        HorizontalExpand="True"
                        StyleClasses="DS14MenuProfileControl RpPanelToggle"
                        Text="{Loc rp-custom-emote-mode-target}"/>
                <Button Name="SelfModeButton"
                        ToggleMode="True"
                        HorizontalExpand="True"
                        StyleClasses="DS14MenuProfileControl RpPanelToggle"
                        Text="{Loc rp-custom-emote-mode-self}"/>
            </BoxContainer>
            <LineEdit Name="MessageInput"
                      StyleClasses="DS14MenuInput"
                      HorizontalExpand="True"/>
            <Label Name="HintLabel" StyleClasses="RpPanelMuted"/>

            <BoxContainer Orientation="Horizontal" SeparationOverride="6" MinHeight="32">
                <Button Name="DeleteButton"
                        StyleClasses="DS14MenuProfileControlDanger"
                        Text="{Loc rp-custom-emote-delete}"/>
                <Control HorizontalExpand="True"/>
                <Button Name="CancelButton"
                        StyleClasses="DS14MenuProfileControl"
                        Text="{Loc rp-custom-emote-cancel}"/>
                <Button Name="SaveButton"
                        StyleClasses="DS14MenuProfileControl"
                        Text="{Loc rp-custom-emote-save}"/>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</DefaultWindow>
