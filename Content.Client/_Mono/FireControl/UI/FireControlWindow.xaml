<controls:FancyWindow xmlns="https://spacestation14.io"
            xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
            xmlns:ui="clr-namespace:Content.Client._Mono.FireControl.UI"
            xmlns:shields="clr-namespace:Content.Client._Crescent.ShipShields.UI"
            Title="{Loc 'gunnery-window-title'}"
            SetSize="980 720"
            MinSize="980 720">
    <!-- LuaM: Dead Space 14 menu look like the AHelp; the radar fills the window and scales with it -->
    <BoxContainer Name="RootBox" Orientation="Horizontal" Margin="8 6 8 8">
        <PanelContainer StyleClasses="LuaMConsoleSection" VerticalExpand="True" HorizontalExpand="False" MinWidth="290" MaxWidth="290">
            <BoxContainer Name="ControlsBox" Orientation="Vertical" Margin="4" SeparationOverride="4">
                <!-- Status Section -->
                <PanelContainer StyleClasses="LuaMConsoleHeader">
                    <Label Name="ServerStatus" Text="{Loc 'gunnery-window-disconnected'}"
                           StyleClasses="LuaMConsoleHeaderLabel" HorizontalAlignment="Center"/>
                </PanelContainer>
                <Button Name="RefreshButton" Access="Public" Text="{Loc admin-logs-refresh}"
                        StyleClasses="LuaMConsoleButton"/>

                <!-- Forge-Change-Start -->

                <!-- Shield status -->
                <PanelContainer Name="ShieldPanel" Visible="False" StyleClasses="LuaMConsoleInset" HorizontalExpand="True">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="6 4 6 6">
                        <Label Text="{Loc 'gunnery-shield-label'}"/>
                        <shields:ShipShieldBar Name="ShieldBar" HorizontalExpand="True" MinHeight="20"/>
                    </BoxContainer>
                </PanelContainer>

                <!-- Forge-Change-End -->

                <!-- Weapons Control Section -->
                <PanelContainer StyleClasses="LuaMConsoleHeader">
                    <Label Name="WeaponsLabel" Text="{Loc 'gunnery-guns'}" HorizontalAlignment="Center" StyleClasses="LuaMConsoleHeaderLabel"/>
                </PanelContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <Button Name="SelectAllButton" Access="Public" Text="{Loc 'gunnery-select-all'}"
                            StyleClasses="LuaMConsoleButton" HorizontalExpand="True"/>
                    <Button Name="UnselectAllButton" Access="Public" Text="{Loc 'gunnery-unselect-all'}"
                            StyleClasses="LuaMConsoleButton" HorizontalExpand="True"/>
                </BoxContainer>
                <PanelContainer StyleClasses="LuaMConsoleInset" HorizontalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="4" SeparationOverride="4">
                        <Button Name="SelectBallisticButton" Access="Public" Text="{Loc 'gunnery-select-ballistic'}"
                                StyleClasses="LuaMConsoleButton" HorizontalExpand="True"/>
                        <Button Name="SelectEnergyButton" Access="Public" Text="{Loc 'gunnery-select-energy'}"
                                StyleClasses="LuaMConsoleButton" HorizontalExpand="True"/>
                        <Button Name="SelectMissileButton" Access="Public" Text="{Loc 'gunnery-select-missiles'}"
                                StyleClasses="LuaMConsoleButton" HorizontalExpand="True"/>
                    </BoxContainer>
                </PanelContainer>
                <!-- LuaM-Change-Start -->

                <!-- IFF-and-Dock-toggles -->
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="4">
                    <Button Name="IFFToggle" Access="Public" Text="{Loc 'gunnery-iff-short'}"
                            StyleClasses="LuaMConsoleButton" HorizontalExpand="True" ToggleMode="True"/>
                    <Button Name="IFFDetailedToggle" Access="Public" Text="{Loc 'shuttle-console-iff-detailed-short'}"
                            StyleClasses="LuaMConsoleButton" HorizontalExpand="True" ToggleMode="True"/>
                </BoxContainer>

                <!-- LuaM-Change-End -->

                <!-- Weapons List -->
                <PanelContainer StyleClasses="LuaMConsoleInset" VerticalExpand="True">
                    <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                        <BoxContainer Name="ControllablesBox" Orientation="Vertical"
                                      HorizontalExpand="True" Margin="4"/>
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>
        </PanelContainer>

        <!-- Radar Display -->
        <BoxContainer Name="RadarContainer" Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" Margin="6 0 0 0">
            <LayoutContainer HorizontalExpand="True" VerticalExpand="True">
                <ui:FireControlNavControl Name="NavRadar" />
            </LayoutContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
