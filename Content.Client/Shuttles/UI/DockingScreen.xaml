<controls:BoxContainer Visible="False"
               HorizontalExpand="True"
               xmlns:controls="https://spacestation14.io"
               xmlns:ui="clr-namespace:Content.Client.Shuttles.UI">
    <!-- LuaM: Dead Space 14 menu colors (LuaMConsole* style classes) -->
    <ui:ShuttleDockControl Name="DockingControl"
                       MouseFilter="Stop"
                       VerticalAlignment="Stretch"
                       VerticalExpand="True"
                       HorizontalExpand="True"
                       Margin="0 0 6 0"/>
    <!-- LuaM: HorizontalExpand True > False, the window got wider and the panel stretched -->
    <controls:PanelContainer StyleClasses="LuaMConsoleSection" VerticalExpand="True" HorizontalExpand="False">
    <controls:BoxContainer Name="RightDisplayDock"
                           VerticalAlignment="Stretch"
                           MinWidth="256"
                           MaxWidth="256"
                           Margin="4"
                           SeparationOverride="4"
                           Orientation="Vertical">
        <!-- FTL Lock Section -->
        <controls:PanelContainer StyleClasses="LuaMConsoleHeader">
            <controls:Label Text="{controls:Loc 'shuttle-console-ftl-lock'}" StyleClasses="LuaMConsoleHeaderLabel" HorizontalAlignment="Center"/>
        </controls:PanelContainer>
        <controls:BoxContainer Orientation="Horizontal" HorizontalAlignment="Stretch" SeparationOverride="4">
            <controls:Button Name="FTLLockEnabledButton"
                             Text="{controls:Loc 'shuttle-console-ftl-lock-enabled'}"
                             ToggleMode="True"
                             HorizontalExpand="True"
                             StyleClasses="LuaMConsoleButton"/>
            <controls:Button Name="FTLLockDisabledButton"
                             Text="{controls:Loc 'shuttle-console-ftl-lock-disabled'}"
                             ToggleMode="True"
                             HorizontalExpand="True"
                             StyleClasses="LuaMConsoleButton"/>
        </controls:BoxContainer>

        <!-- Docks Section -->
        <controls:PanelContainer StyleClasses="LuaMConsoleHeader">
            <controls:Label Text="{controls:Loc 'shuttle-console-docks-label'}" StyleClasses="LuaMConsoleHeaderLabel" HorizontalAlignment="Center"/>
        </controls:PanelContainer>
        <controls:Button Name="UndockAllButton"
                         Text="{controls:Loc 'shuttle-console-undock-all'}"
                         StyleClasses="LuaMConsoleButton"/>
        <controls:PanelContainer StyleClasses="LuaMConsoleInset" VerticalExpand="True">
            <controls:ScrollContainer VerticalExpand="True" HScrollEnabled="False"
                                      ReturnMeasure="True" Margin="4">
                <controls:BoxContainer Name="DockPorts" Orientation="Vertical"/>
            </controls:ScrollContainer>
        </controls:PanelContainer>
    </controls:BoxContainer>
    </controls:PanelContainer>
</controls:BoxContainer>
