<controls:BoxContainer Visible="False"
       HorizontalExpand="True"
       VerticalExpand="True"
       xmlns:controls="https://spacestation14.io"
       xmlns:ui="clr-namespace:Content.Client.Shuttles.UI"
       xmlns:lua="clr-namespace:Content.Client._Lua.Shuttles.UI">
    <!-- Lua-start: map screen layout -->
    <!-- LuaM: Dead Space 14 menu colors (LuaMConsole* style classes) -->
    <controls:PanelContainer HorizontalExpand="True" VerticalExpand="True"> <!-- LuaM: no own background, the window shell shows through -->
        <controls:BoxContainer Orientation="Vertical" SeparationOverride="7" VerticalExpand="True">
            <controls:BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="9">
                <ui:ShuttleMapControl Name="MapRadar"
                                      MouseFilter="Stop"
                                      HorizontalExpand="True"
                                      VerticalExpand="True"
                                      VerticalAlignment="Stretch"/>
                <controls:BoxContainer Name="RightDisplayMap"
                                       VerticalAlignment="Stretch"
                                       HorizontalAlignment="Right"
                                       MinWidth="292"
                                       MaxWidth="292"
                                       Orientation="Vertical"
                                       SeparationOverride="5"
                                       VerticalExpand="True">
                    <!-- FTL status -->
                    <controls:PanelContainer StyleClasses="LuaMConsoleSection" MinHeight="46" HorizontalExpand="True">
                        <controls:BoxContainer Orientation="Vertical" Margin="8 5" SeparationOverride="3">
                            <controls:BoxContainer Orientation="Horizontal">
                                <controls:Label Name="MapDisplayLabel"
                                                Text="{controls:Loc 'shuttle-console-ftl-label'}"
                                                StyleClasses="LuaMConsoleHeaderLabel"
                                                HorizontalExpand="True"/>
                                <controls:Label Name="MapFTLState"
                                                Text="{controls:Loc 'shuttle-console-ftl-state-Available'}"
                                                FontColorOverride="#C5CEDB"
                                                HorizontalAlignment="Right"/>
                            </controls:BoxContainer>
                            <lua:ShuttleBssProgressBar Name="FTLBar" HorizontalExpand="True" MinHeight="14"/>
                        </controls:BoxContainer>
                    </controls:PanelContainer>
                    <!-- Map objects -->
                    <controls:PanelContainer StyleClasses="LuaMConsoleSection" HorizontalExpand="True" VerticalExpand="True">
                        <controls:BoxContainer Orientation="Vertical" Margin="7 6" SeparationOverride="4" VerticalExpand="True">
                            <controls:Label Name="HyperspaceLabel"
                                            Text="{controls:Loc 'shuttle-console-map-objects'}"
                                            StyleClasses="LuaMConsoleHeaderLabel"
                                            HorizontalExpand="True"/>
                            <!-- LuaM: object search -->
                            <controls:LineEdit Name="MapObjectSearch" StyleClasses="LuaMConsoleInput"
                                               PlaceHolder="{controls:Loc 'shuttle-console-map-search'}"
                                               HorizontalExpand="True"/>
                            <controls:ScrollContainer VerticalExpand="True" HScrollEnabled="False" VScrollEnabled="True">
                                <controls:BoxContainer Name="HyperspaceDestinations"
                                                       Orientation="Vertical"
                                                       SeparationOverride="3"/>
                            </controls:ScrollContainer>
                        </controls:BoxContainer>
                    </controls:PanelContainer>
                    <!-- Settings -->
                    <controls:PanelContainer StyleClasses="LuaMConsoleSection" HorizontalExpand="True">
                        <controls:BoxContainer Orientation="Vertical" Margin="7 5" SeparationOverride="3">
                            <controls:Label Name="SettingsLabel"
                                            Text="{controls:Loc 'shuttle-console-map-settings'}"
                                            StyleClasses="LuaMConsoleHeaderLabel"/>
                            <controls:GridContainer Columns="2" HSeparationOverride="3" VSeparationOverride="3">
                                <controls:Button Name="MapFTLButton" StyleClasses="LuaMConsoleButton"
                                                 ToggleMode="True"
                                                 MinHeight="18"
                                                 HorizontalExpand="True"
                                                 Text="{controls:Loc 'shuttle-console-ftl-button'}"
                                                 TextAlign="Center"/>
                                <!-- Mono - Autopilot -->
                                <controls:Button Name="MapAutopilotButton" StyleClasses="LuaMConsoleButton"
                                                 ToggleMode="True"
                                                 MinHeight="18"
                                                 HorizontalExpand="True"
                                                 Text="{controls:Loc 'shuttle-console-autopilot-button'}"
                                                 TextAlign="Center"/>
                            </controls:GridContainer>
                            <!-- LuaM: the scan button is gone, the map refreshes by itself; beacons take the whole row -->
                            <controls:Button Name="MapBeaconsButton" StyleClasses="LuaMConsoleButton"
                                             ToggleMode="True"
                                             Pressed="True"
                                             MinHeight="18"
                                             HorizontalExpand="True"
                                             Text="{controls:Loc 'shuttle-console-map-beacons'}"
                                             TextAlign="Center"/>
                        </controls:BoxContainer>
                    </controls:PanelContainer>
                    <!-- LuaM-start: map marker, shared with the radar marker on NAV -->
                    <controls:PanelContainer StyleClasses="LuaMConsoleSection" HorizontalExpand="True">
                        <controls:BoxContainer Orientation="Vertical" Margin="7 5" SeparationOverride="3">
                            <controls:Label Text="{controls:Loc 'shuttle-console-map-target'}" StyleClasses="LuaMConsoleHeaderLabel"/>
                            <controls:BoxContainer Orientation="Horizontal" SeparationOverride="3">
                                <controls:LineEdit Name="MapTargetX" StyleClasses="LuaMConsoleInput" HorizontalExpand="True" MinWidth="60"/>
                                <controls:LineEdit Name="MapTargetY" StyleClasses="LuaMConsoleInput" HorizontalExpand="True" MinWidth="60"/>
                                <controls:Button Name="MapTargetSet" StyleClasses="LuaMConsoleButton"
                                                 MinHeight="18"
                                                 Text="{controls:Loc 'shuttle-console-set-target'}"
                                                 ToolTip="{controls:Loc 'shuttle-console-set-target-description'}"
                                                 TextAlign="Center"/>
                                <controls:Button Name="MapTargetHide" StyleClasses="LuaMConsoleButton"
                                                 ToggleMode="True"
                                                 MinHeight="18"
                                                 Text="{controls:Loc 'shuttle-console-hide-target'}"
                                                 ToolTip="{controls:Loc 'shuttle-console-hide-target-description'}"
                                                 TextAlign="Center"/>
                            </controls:BoxContainer>
                            <controls:BoxContainer Orientation="Horizontal" SeparationOverride="3">
                                <controls:Button Name="MapTargetAutopilot" StyleClasses="LuaMConsoleButton"
                                                 MinHeight="18"
                                                 HorizontalExpand="True"
                                                 Text="{controls:Loc 'shuttle-console-autopilot-button'}"
                                                 ToolTip="{controls:Loc 'shuttle-console-target-autopilot-description'}"
                                                 TextAlign="Center"/>
                                <controls:Button Name="MapTargetClear" StyleClasses="LuaMConsoleButton"
                                                 MinHeight="18"
                                                 HorizontalExpand="True"
                                                 Text="{controls:Loc 'shuttle-console-clear-target'}"
                                                 ToolTip="{controls:Loc 'shuttle-console-clear-target-description'}"
                                                 TextAlign="Center"/>
                            </controls:BoxContainer>
                        </controls:BoxContainer>
                    </controls:PanelContainer>
                    <!-- LuaM-end -->
                    <!-- Zoom -->
                    <controls:PanelContainer StyleClasses="LuaMConsoleSection" HorizontalExpand="True">
                        <controls:BoxContainer Orientation="Vertical" Margin="7 5" SeparationOverride="3">
                            <controls:Label Text="{controls:Loc 'shuttle-console-map-zoom'}" StyleClasses="LuaMConsoleHeaderLabel" HorizontalExpand="True"/>
                            <controls:Slider Name="MapZoomSlider" MinValue="0" MaxValue="1" Value="0" HorizontalExpand="True" MinWidth="92"/>
                        </controls:BoxContainer>
                    </controls:PanelContainer>
                </controls:BoxContainer>
            </controls:BoxContainer>
        </controls:BoxContainer>
    </controls:PanelContainer>
    <!-- Lua-end -->
</controls:BoxContainer>
